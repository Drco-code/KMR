// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

// AdminJS's Prisma adapter (@adminjs/prisma) only knows how to read schema
// metadata (models/fields/enums) from the legacy `prisma-client-js`
// generator's `Prisma.dmmf.datamodel` export — the newer `prisma-client`
// generator above doesn't expose it. This second client is used ONLY for
// that metadata; all actual reads/writes still go through PrismaModuleService
// (the adapter-driven client above), never this one.
generator adminJsMetadata {
  provider = "prisma-client-js"
  output   = "../generated/prisma-legacy"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// packages/backend/prisma/schema.prisma
//
// ==========================================================
// DATABASE OVERVIEW
// ==========================================================
// This schema powers the Digital Catalog & WhatsApp Ordering
// System. It has 3 functional groups:
//   1. Catalog        -> what contractors browse
//   2. Quote Requests -> the backup audit trail before WhatsApp
//   3. Auth (Better Auth) -> how staff log into the admin panel
// ==========================================================

// ==========================================
// 🏢 1. CORE CATALOG & PRODUCT MODELS
// ==========================================

// A Category groups related products together (e.g. "Lumber",
// "Fasteners", "Power Tools"). Used to build the site navigation
// and filter the catalog.

model Category {
  id   String @id @default(uuid())
  name String @unique // Display name, e.g. "Lumber"
  slug String @unique // URL-safe version for Next.js routes, e.g. "/catalog/lumber"

  // Optional self-link for nav grouping, nested arbitrarily deep (e.g. the
  // "Tools" nav item has "Power Tool (A-M)" as a child, which in turn has
  // "Bench & Stationary Tool" as a grandchild). Top-level categories have
  // parentId null. A category can be a
  // pure group header (no products of its own, only children) or a normal
  // browsable leaf category with products — both are valid. onDelete:
  // SetNull so deleting a parent ungroups its children instead of cascading.
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  // Controls whether this category is eligible to appear in the storefront's
  // dropdown/mega-menu nav at any tier. A category can still hold products
  // and be filtered on via the catalog sidebar without appearing in nav.
  showInNav Boolean @default(true)
  // Sibling order within its nav tier, ascending. Categories with equal
  // navOrder fall back to creation order — see storefront lib/category-tree.ts.
  navOrder  Int     @default(0)

  // LINK: One Category has many Products.
  // If you delete a Category, Prisma blocks it (see onDelete: Restrict
  // on the Product side) so you can't accidentally orphan products.
  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// A single sellable item in the catalog (a plank of timber, a box
// of nails, a power tool, etc). This is what shows up on the
// public-facing site and what gets added to the WhatsApp quote cart.

model Product {
  id          String  @id @default(uuid())
  name        String // e.g. "Planed Oak Timber 2x4"
  slug        String  @unique // URL-safe, used for individual product pages
  description String? @db.Text // Long-form text, optional

  // Not a fixed price field on purpose — building supply pricing is
  // often quote-based ("$15.00 / plank" or "Inquire for wholesale rate")
  priceDescription String?

  // Stores only Cloudinary URL strings, in display order. The actual
  // image files live in Cloudinary, NOT in Postgres — keeps the DB
  // light and fast, and avoids the storage-bloat problem described
  // in the doc. images[0] is the cover image used in catalog listings;
  // the full array powers the product-page image carousel.
  images String[] @default([])

  // Sidecar arrays, index-aligned with `images`. Written automatically by
  // @adminjs/upload (see AdminModuleService's uploadFeature `properties`
  // config) whenever staff upload a file through the admin dashboard —
  // never set by the public API. Required by @adminjs/upload's own
  // multi-file preview component, which crashes if `mimeType` isn't a
  // real array property (see file.tsx in that package: it does
  // `mimeType[index]` unconditionally).
  imagesMimeType String[] @default([])
  imagesFilename String[] @default([])

  // Deliberately Json, NOT Int[]. @adminjs/prisma's Resource.prepareParams()
  // routes every Int-typed value through safeParseNumber(), which does
  // `Number(value)` unconditionally — for a one-element array that silently
  // coerces to the bare element (`Number([10737]) === 10737`), and for a
  // multi-element array it coerces to NaN, dropped entirely. Either way
  // Prisma then rejects the write. Json values are passed through by that
  // adapter untouched regardless of shape, so storing a plain JSON array of
  // numbers here sidesteps the bug completely.
  imagesSize Json @default("[]")

  // Lets admins hide a product from the public catalog without
  // deleting it (e.g. temporarily out of stock).
  isActive Boolean @default(true)

  // Staff-controlled flag for the homepage "Signature Collections"
  // section. Any product can be featured (not restricted to paint),
  // staff self-curate. No ordering field — featured products just show
  // in the same createdAt-desc order as everything else.
  isFeatured Boolean @default(false)

  // Internal inventory count. Admin-only — never returned by the public
  // catalog endpoints (see ProductModuleService.findAll/findOne), only
  // visible/editable through the AdminJS staff dashboard.
  stock Int @default(0)

  // LINK: A Product can belong to multiple Categories (see ProductCategory
  // below), with exactly one marked isPrimary — that one drives the
  // canonical URL/breadcrumb on the storefront product page.
  categories ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join table for the Product<->Category many-to-many relationship. One row
// per (product, category) assignment. Exactly one row per product must have
// isPrimary: true — that's the category the storefront uses for the
// canonical URL/breadcrumb (see ProductModuleService for the enforcement,
// and the partial unique index in this model's migration for the DB-level
// backstop).
model ProductCategory {
  id         String  @id @default(uuid())
  productId  String
  categoryId String
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
}

// A brand KMR carries (e.g. a paint manufacturer). Powers the "Brands We
// Work With" homepage section — staff add/remove brands here and the
// section updates automatically, no code changes needed.
model Brand {
  id         String  @id @default(uuid())
  name       String  @unique
  websiteUrl String? // Optional link-out when a visitor clicks the logo.

  // Lets admins hide a brand from the homepage without deleting it.
  isActive Boolean @default(true)

  // Same array-of-one-plus-sidecars pattern as Product.images (see the
  // comments there) — required by @adminjs/upload's preview component,
  // even though a Brand only ever has a single logo.
  logo           String[] @default([])
  logoMimeType   String[] @default([])
  logoFilename   String[] @default([])
  logoSize       Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The single promo/announcement bar shown at the very top of the storefront
// header (e.g. "Complimentary color consultation with any purchase over
// GH₵300"). Staff edit this one row from the AdminJS dashboard; the
// storefront hides the bar entirely while the row is missing, isActive is
// false, or the message is blank. There is exactly one row (seeded by the
// migration; the admin dashboard hides new/delete for this resource).
model PromoBanner {
  id        String  @id @default(uuid())
  // The promo text, e.g. "Free delivery on orders over GH₵300".
  message   String?
  // Master switch — set false to pause the promo without deleting the text.
  isActive  Boolean @default(true)
  // Optional URL the bar links to (e.g. "/catalog" or "/quote").
  link      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 📋 2. BACKUP AUDIT TRAIL / QUOTE LOGS
// ==========================================
// Right before the site redirects a customer into WhatsApp, the
// cart contents get silently saved here. If their phone dies or
// WhatsApp doesn't open properly, the sales team still has the
// lead — nothing gets lost.

// One customer's quote submission (the "envelope").

model QuoteRequest {
  id              String  @id @default(uuid())
  customerName    String
  customerCompany String?
  customerPhone   String?
  // Delivery/pickup location so the sales team knows where the order goes.
  customerLocation String?

  // Lets the admin dashboard track follow-up state on each lead.
  status String @default("PENDING") // PENDING, RESPONDED, ARCHIVED

  // LINK: One QuoteRequest has many QuoteRequestItems (the line items
  // in that customer's cart — e.g. "50x Planed Oak Timber").
  items QuoteRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single line item inside a customer's quote cart.

model QuoteRequestItem {
  id String @id @default(uuid())

  // LINK: Belongs to one QuoteRequest.
  // onDelete: Cascade means if the parent QuoteRequest is ever
  // deleted, its line items are automatically cleaned up too —
  // no orphaned rows left behind.
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  // Deliberately stored as raw text rather than linked to Product.id.
  // This means if a Product is later deleted or renamed, this
  // historical quote log stays accurate and unaffected — it's a
  // permanent snapshot of what was asked for at that point in time.
  productName String
  quantity    Int
}

// ==========================================
// 🔐 3. BETTER AUTH MODELS (ADMIN LOGIN)
// ==========================================
// Better Auth is a free, open-source, self-hosted auth library —
// no Clerk/Auth0 subscription. These 3 models are the exact table
// shape Better Auth requires to manage staff accounts, login
// sessions, and (if enabled) linked login providers.
//
// NOTE: as currently modeled, the Account table only has OAuth
// fields (accessToken/refreshToken/idToken/scope) — there's no
// password/credential column. That's fine if admins log in via
// Google/GitHub OAuth. If admins are meant to log in with an
// email + password instead, Better Auth's email/password provider
// needs to be enabled, which stores its hash on Account differently
// than what's shown here — worth confirming which login method is
// actually intended before this ships.

// A staff member who can access the AdminJS dashboard.

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // Gatekeeper field — AdminJS/NestJS guards check this to decide
  // who's allowed into the backend dashboard.
  role String @default("admin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // LINK: One User can have many login Sessions (e.g. logged in on
  // both a desktop and a phone at once) and many linked Accounts
  // (e.g. one per OAuth provider, if more than one is enabled).
  sessions Session[]
  accounts Account[]

  @@map("user")
}

// A single active login "pass" — this is what the JWT / HTTP-only
// cookie described in the doc actually points to.

model Session {
  id        String   @id @default(uuid())
  token     String   @unique // Matched against the cookie value on every request by NestJS guards
  expiresAt DateTime // Enforces the "auto logout after 24h" behavior described in the doc
  ipAddress String?
  userAgent String?

  // Tracks the last time this session was active. Used for inactivity-based
  // logout — if lastActivityAt is older than the configured timeout (e.g. 1 hour),
  // the session is considered expired and the user is logged out.
  lastActivityAt DateTime? @updatedAt

  // LINK: Every Session belongs to exactly one User.
  // onDelete: Cascade — if a User is deleted, all their sessions
  // (i.e. all their logged-in devices) are wiped out with them.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Speeds up "find all sessions for this user" (e.g. force logout
  // everywhere) queries.
  @@index([userId])
  @@map("session")
}

// Represents one external login method linked to a User
// (currently shaped for OAuth providers like Google — see note above).

model Account {
  id         String @id @default(uuid())
  accountId  String // The ID given by the external provider (e.g. Google's user ID)
  providerId String // Which provider this is, e.g. "google"

  // LINK: Every Account belongs to exactly one User.
  // onDelete: Cascade — deleting a User removes their linked
  // provider accounts too.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  password String?

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
