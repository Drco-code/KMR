{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../generated/prisma-legacy/**/*",
        "outDir": "dist/generated",
        "watchAssets": true
      },
      {
        "include": "admin-module/dashboard/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}
