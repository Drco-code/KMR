/generated/prisma

# AdminJS's pre-built frontend bundle (see package.json "bundle:admin",
# src/admin-module/bundle-admin.ts, and the ADMIN_JS_TMP_DIR env var set in
# main.ts) — a build artifact, regenerated on every deploy, never committed.
# Named "adminjs-bundle" rather than AdminJS's dot-directory default
# (.adminjs) because Render's build-to-runtime packaging silently drops
# dot-directories — that cost real debugging time before being caught.
/adminjs-bundle


.claude
